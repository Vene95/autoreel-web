# AutoReel - environment local (NU se commit-eaza; e in .gitignore)
#
# Valorile de aici sunt aceleasi cu fallback-urile hardcoded din
# lib/core/config/env.dart, deci app-ul merge identic si fara acest fisier.
# Fisierul exista pentru doua motive:
#   1. pubspec.yaml declara `.env` ca asset -> build-ul CRAPA daca lipseste.
#   2. iti permite sa suprascrii local o cheie (ex: alt proiect Supabase)
#      fara sa modifici codul.

SUPABASE_URL=https://ngdbnlcrejiqyumdvdnw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_puQ5QRSxcFipFQkD8MXTlg_bHzUJUCw

APP_PUBLIC_URL=https://app.autoreel.ro

SENTRY_DSN=https://61ae9a0a534871e58e3a6301c45565ce@o4511387080654848.ingest.de.sentry.io/4511387102019664

# SENTRY_ENVIRONMENT: LASA-L COMENTAT.
# .env e bundle-uit ca asset in APK/AAB, deci o valoare pusa aici ajunge si
# in build-urile release si ar raporta "development" in production. Lasat
# nesetat, env.dart il deduce automat din modul de build (debug -> development,
# release -> production).
# SENTRY_ENVIRONMENT=development
